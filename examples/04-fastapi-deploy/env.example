# env.example — copy to .env and fill in placeholders.
# NEVER commit a real .env. Setting names are to confirm at
# validation for stac-fastapi.pgstac 7.1.0; the Postgres password
# setting is required by the app's settings in the fleet deployment.
STAC_HOST=127.0.0.1
STAC_PORT=8001
# Postgres connection for the pgSTAC database (placeholder DSN):
POSTGRES_DSN=<POSTGRES_DSN>
# Required Postgres password setting (exact name to confirm):
PGPASSWORD=<PGPASSWORD>
# Docs endpoints (set these: without them, /docs 404s on the
# Node-3 build while the API itself stays healthy):
DOCS_URL=/docs
OPENAPI_URL=/openapi.json
